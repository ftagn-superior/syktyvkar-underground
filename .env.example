# DATABASE_URL is required for every world, including guest play.
# The three Telegram settings are optional together.
PUBLIC_ORIGIN=
CLIENT_ID=
CLIENT_SECRET=
DATABASE_URL=postgresql://su_app:CHANGE_ME@127.0.0.1:5432/syktyvkar_underground
# Allow signed-in players to create one catalog item with /giveme <type-id>.
# Set false and restart the server to stop new grants; existing items remain.
SU_ITEM_CREATION_ENABLED=true
