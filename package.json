{
  "name": "syktyvkar-underground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "world:build": "node --import tsx tools/world-build/src/index.ts",
    "world:catalog:check": "node --import tsx tools/world-build/src/catalog-command.ts",
    "world:preview-ring": "node --import tsx tools/world-build/src/preview-ring.ts",
    "world:ring:layers": "node --import tsx tools/world-build/src/ring-layout.ts",
    "world:acceptance": "node --import tsx tests/streaming-fixture.ts",
    "dev": "pnpm world:build && node tools/dev.mjs",
    "check": "tsc --noEmit && node tools/check-boundaries.mjs && node --import tsx tools/world-build/src/catalog-command.ts --sources",
    "test": "vitest run",
    "build": "pnpm world:build && pnpm check && node tools/build.mjs",
    "start": "node dist/server/main.mjs",
    "load": "node --import tsx tools/load-test/src/index.ts",
    "test:large-map:l0": "pnpm build && node --import tsx tests/large-map-l0.ts",
    "test:large-map:l1": "pnpm build && node --import tsx tests/large-map-l1.ts",
    "test:physics:browser": "node --import tsx tests/browser-physics.ts",
    "test:assets:browser": "node --import tsx tests/browser-assets.ts",
    "test:touch:browser": "node --import tsx tests/browser-touch.ts",
    "test:gamepad:browser": "node --import tsx tests/browser-gamepad.ts",
    "test:first-person:browser": "node --import tsx tests/browser-first-person.ts",
    "test:first-person:geometry": "node --import tsx tests/browser-first-person-geometry.ts",
    "test:browser": "node --import tsx tests/browser-smoke.ts",
    "format": "prettier --write apps packages tools tests content package.json tsconfig.json vitest.config.ts pnpm-workspace.yaml",
    "test:soak": "node --import tsx tests/browser-soak.ts",
    "test:network": "node --import tsx tests/browser-network.ts",
    "test:network:netem": "bash tests/browser-network-netem.sh",
    "test:restart:browser": "node --import tsx tests/browser-restart.ts",
    "test:polish:browser": "node --import tsx tests/browser-polish.ts",
    "test:render:browser": "node --import tsx tests/browser-render-profile.ts",
    "test:loading:browser": "node --import tsx tests/browser-loading-profile.ts",
    "test:trees:browser": "node --import tsx tests/browser-tree-instancing.ts",
    "test:static-glb:browser": "node --import tsx tests/browser-static-glb-instancing.ts",
    "test:art:browser": "node --import tsx tests/art-style-preview.ts",
    "test:buildings:browser": "node --import tsx tests/browser-buildings.ts",
    "test:large-map:l2": "node --import tsx tests/large-map-l2.ts",
    "test:large-map:l3": "pnpm build && node --import tsx tests/large-map-l3.ts",
    "test:large-map:l4": "pnpm build && node --import tsx tests/large-map-l4.ts",
    "test:streaming:browser": "pnpm build && node --import tsx tests/streaming-browser.ts",
    "test:streaming:load": "pnpm build && node --import tsx tests/streaming-load.ts",
    "test:streaming:soak": "pnpm build && node --import tsx tests/streaming-soak.ts",
    "test:streaming:netem": "pnpm build && bash tests/streaming-netem.sh",
    "test:streaming:matrix": "pnpm build && node --import tsx tests/streaming-matrix.ts",
    "test:streaming:verify": "pnpm build && node --import tsx tests/streaming-verify.ts",
    "test:streaming:evidence": "node --import tsx tests/streaming-evidence.ts",
    "db:migrate": "node --import tsx apps/server/src/migrate.ts",
    "db:migrate:built": "node dist/server/migrate.mjs",
    "world:layout:validate": "node --import tsx apps/server/src/layout-command.ts validate",
    "world:layout:export": "node --import tsx apps/server/src/layout-command.ts export",
    "world:layout:validate:built": "node dist/server/layout-command.mjs validate",
    "world:layout:export:built": "node dist/server/layout-command.mjs export",
    "world:layout:patch": "node --import tsx apps/server/src/layout-command.ts patch",
    "world:layout:patch:built": "node dist/server/layout-command.mjs patch",
    "world:layout:apply": "node --import tsx apps/server/src/layout-command.ts apply",
    "world:layout:apply:built": "node dist/server/layout-command.mjs apply",
    "world:migrate": "node --import tsx apps/server/src/migrate-world.ts",
    "world:migrate:built": "node dist/server/migrate-world.mjs",
    "test:accounts": "node tools/test-database.mjs",
    "test:accounts:browser": "node tools/test-database.mjs --browser",
    "test:reactions:browser": "node --import tsx tests/browser-reactions.ts",
    "test:animations:browser": "node --import tsx tests/browser-animations.ts",
    "test:chat:browser": "node --import tsx tests/browser-chat.ts",
    "test:audio:browser": "node --import tsx tests/browser-audio.ts",
    "test:items": "node tools/test-database.mjs --items",
    "test:items:browser": "node tools/test-database.mjs --items --browser",
    "test:giveme:browser": "node tools/test-database.mjs --giveme --browser",
    "test:avatars:browser": "node tools/test-database.mjs --avatars --browser",
    "test:avatars:profile": "node --import tsx tests/browser-avatar-profile.ts",
    "test:dynamic-map:browser": "node --import tsx tests/dynamic-map-browser.ts",
    "test:static-placement:browser": "node --import tsx tests/browser-static-placement.ts",
    "test:static-removal:browser": "node --import tsx tests/browser-static-removal.ts",
    "test:static-removal:city": "node --import tsx tests/browser-static-removal-city.ts",
    "test:world-ui:browser": "node --import tsx tests/browser-world-ui.ts"
  },
  "devDependencies": {
    "@babylonjs/core": "9.35.0",
    "@colyseus/core": "0.18.28",
    "@colyseus/schema": "5.0.47",
    "@colyseus/ws-transport": "0.18.5",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "@colyseus/sdk": "0.18.10",
    "@types/express": "5.0.6",
    "prettier": "3.10.0",
    "@types/pg": "8.23.1",
    "jose": "6.2.17",
    "openid-client": "6.8.9"
  }
}
